{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vitally REST Accounts Users API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users for an account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.rest.vitally.io/resources/accounts/:accountId/users",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of items to return. Max/default is 100."
              },
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "The cursor returned from a previous request (from the next property)."
              }
            ]
          },
          "docs": "List users for an account"
        },
        {
          "info": {
            "name": "List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.rest.vitally.io/resources/users",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of items to return. Max/default is 100."
              },
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "The cursor returned from a previous request (from the next property)."
              },
              {
                "name": "sortBy",
                "value": "",
                "type": "query",
                "description": "How to order results. Default updatedAt."
              }
            ]
          },
          "docs": "List users"
        },
        {
          "info": {
            "name": "Create a user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.rest.vitally.io/resources/users",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a user"
        },
        {
          "info": {
            "name": "Get a user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.rest.vitally.io/resources/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a user"
        },
        {
          "info": {
            "name": "Update a user",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{subdomain}.rest.vitally.io/resources/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a user"
        }
      ]
    }
  ],
  "bundled": true
}