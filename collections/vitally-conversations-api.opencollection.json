{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vitally REST Accounts Conversations API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Conversations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List conversations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.rest.vitally.io/resources/conversations",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of items to return. Max/default is 100."
              },
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "The cursor returned from a previous request (from the next property)."
              },
              {
                "name": "sortBy",
                "value": "",
                "type": "query",
                "description": "How to order results. Default updatedAt."
              }
            ]
          },
          "docs": "List conversations"
        },
        {
          "info": {
            "name": "Create a conversation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.rest.vitally.io/resources/conversations",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a conversation"
        }
      ]
    }
  ],
  "bundled": true
}